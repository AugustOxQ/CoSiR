digraph AFF_design {
  graph [layout=neato, bgcolor="white", dpi=200, pad=0.25,
         overlap=true, splines=true, fontname="DejaVu Sans", fontsize=25,
         labelloc=t, label="One-sided affect steering as one design, and where each component came from"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
        fontsize=16, margin="0.10,0.10", color="#1B8A7A", fillcolor="white",
        fontcolor="#263444", penwidth=2, width=2.5, height=5.15, fixedsize=true];
  edge [color="#1B8A7A", penwidth=1.7, arrowsize=0.7,
        fontname="DejaVu Sans", fontsize=15];
inputs [pos="110,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Inputs<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">query; 4 support<BR ALIGN="LEFT"/>and 4 contrast<BR ALIGN="LEFT"/>pairs; 13<BR ALIGN="LEFT"/>candidates;<BR ALIGN="LEFT"/>frozen CLIP<BR ALIGN="LEFT"/>ViT-B/32 features<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
groupings [pos="308,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Groupings<BR ALIGN="LEFT"/>(label-free)<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">affect: Leiden<BR ALIGN="LEFT"/>communities on<BR ALIGN="LEFT"/>GoEmotions<BR ALIGN="LEFT"/>caption<BR ALIGN="LEFT"/>probabilities (41<BR ALIGN="LEFT"/>groups); image<BR ALIGN="LEFT"/>and caption:<BR ALIGN="LEFT"/>k-means on CLIP<BR ALIGN="LEFT"/>features (64 each)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#747B82" POINT-SIZE="13">from: grouping study,<BR ALIGN="LEFT"/>5 Oct; evidence:<BR ALIGN="LEFT"/>Leiden told margin<BR ALIGN="LEFT"/>+1.64 vs k-means<BR ALIGN="LEFT"/>+1.10 at 41 groups<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
heads [pos="506,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Heads<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">logistic<BR ALIGN="LEFT"/>regressions on<BR ALIGN="LEFT"/>CLIP features<BR ALIGN="LEFT"/>(60,000 training<BR ALIGN="LEFT"/>rows) place any<BR ALIGN="LEFT"/>image or caption<BR ALIGN="LEFT"/>in each grouping;<BR ALIGN="LEFT"/>agreement =<BR ALIGN="LEFT"/>image posterior ·<BR ALIGN="LEFT"/>caption posterior<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#747B82" POINT-SIZE="13">from: partition-head<BR ALIGN="LEFT"/>reader, 4 Oct;<BR ALIGN="LEFT"/>evidence: told the<BR ALIGN="LEFT"/>right grouping, the<BR ALIGN="LEFT"/>heads beat their<BR ALIGN="LEFT"/>control by +1.14<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
reader_features [pos="704,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Reader<BR ALIGN="LEFT"/>features<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">per grouping:<BR ALIGN="LEFT"/>support<BR ALIGN="LEFT"/>agreement,<BR ALIGN="LEFT"/>contrast<BR ALIGN="LEFT"/>agreement, their<BR ALIGN="LEFT"/>difference, two<BR ALIGN="LEFT"/>spreads, a match<BR ALIGN="LEFT"/>share (18<BR ALIGN="LEFT"/>numbers)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
reader [pos="902,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Learned reader<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">multinomial<BR ALIGN="LEFT"/>logistic regression<BR ALIGN="LEFT"/>trained on<BR ALIGN="LEFT"/>practice episodes<BR ALIGN="LEFT"/>built from the<BR ALIGN="LEFT"/>groupings (49,152<BR ALIGN="LEFT"/>per painting half;<BR ALIGN="LEFT"/>no evaluation<BR ALIGN="LEFT"/>labels) gives a<BR ALIGN="LEFT"/>probability per<BR ALIGN="LEFT"/>grouping<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#747B82" POINT-SIZE="13">from: reader round 1,<BR ALIGN="LEFT"/>6 Oct; evidence: 79%<BR ALIGN="LEFT"/>right on practice<BR ALIGN="LEFT"/>episodes, 51.3% on<BR ALIGN="LEFT"/>real ones<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
gate [pos="1100,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Confidence<BR ALIGN="LEFT"/>gate<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">open when the<BR ALIGN="LEFT"/>top probability<BR ALIGN="LEFT"/>leads the second<BR ALIGN="LEFT"/>by at least tau (a<BR ALIGN="LEFT"/>percentile of the<BR ALIGN="LEFT"/>development<BR ALIGN="LEFT"/>margins)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#747B82" POINT-SIZE="13">from: reader round 1,<BR ALIGN="LEFT"/>6 Oct; evidence:<BR ALIGN="LEFT"/>+0.444 vs +0.313<BR ALIGN="LEFT"/>without the gate<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
rule [pos="1298,500!", height=5.15, color="#1B8A7A", fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>One-sided rule<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">steer only when<BR ALIGN="LEFT"/>the top grouping<BR ALIGN="LEFT"/>is affect, the<BR ALIGN="LEFT"/>grouping least<BR ALIGN="LEFT"/>redundant with B<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#747B82" POINT-SIZE="13">from: brainstorm and<BR ALIGN="LEFT"/>round 3, 6 Oct;<BR ALIGN="LEFT"/>evidence: +0.700<BR ALIGN="LEFT"/>development, +0.591<BR ALIGN="LEFT"/>fresh<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
base [pos="110,150!", height=3.8, color="#9AA0A6", fillcolor="#F2F3F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="17"><B>Condition-free<BR ALIGN="LEFT"/>score B<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#263444" POINT-SIZE="16">cosine + centered<BR ALIGN="LEFT"/>factor term +<BR ALIGN="LEFT"/>averaged heads;<BR ALIGN="LEFT"/>uses the<BR ALIGN="LEFT"/>examples, ignores<BR ALIGN="LEFT"/>the aspect<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#747B82" POINT-SIZE="13">from: method A and<BR ALIGN="LEFT"/>partition heads, 3 to 4<BR ALIGN="LEFT"/>Oct; 18.34 R@1 on<BR ALIGN="LEFT"/>development episodes<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
fused [pos="1496,500!", height=5.15, color="#1B8A7A", fillcolor="#1B8A7A", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="17"><B>Fused score<BR ALIGN="LEFT"/></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16">(1 + λu)·z(B) +<BR ALIGN="LEFT"/>λa·gate·z(T);<BR ALIGN="LEFT"/>weights from 224<BR ALIGN="LEFT"/>cells, chosen on<BR ALIGN="LEFT"/>one parity half of<BR ALIGN="LEFT"/>the episodes and<BR ALIGN="LEFT"/>applied to the<BR ALIGN="LEFT"/>other<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
inputs -> groupings [pos="e,218,500 200,500 206,500 206,500 211,500"];
groupings -> heads [pos="e,416,500 398,500 404,500 404,500 409,500"];
heads -> reader_features [pos="e,614,500 596,500 602,500 602,500 607,500"];
reader_features -> reader [pos="e,812,500 794,500 800,500 800,500 805,500"];
reader -> gate [pos="e,1010,500 992,500 998,500 998,500 1003,500"];
gate -> rule [pos="e,1208,500 1190,500 1196,500 1196,500 1201,500"];
rule -> fused [pos="e,1406,500 1388,500 1394,500 1394,500 1399,500"];
inputs -> base [color="#9AA0A6", pos="e,110,286.8 110,314.6 110,307 110,301 110,294"];
heads -> fused [label="grouping score T", lp="1010,772", pos="e,1461,685.4 506,685.4 506,710 506,750 506,750 506,750 1461,750 1461,750 1461,750 1461,710 1461,693"];
base -> fused [color="#9AA0A6", pos="e,1528,685.4 20,150 -10,150 -10,150 -10,150 -10,150 -10,820 -10,820 -10,820 1528,820 1528,820 1528,820 1528,720 1528,693"];
tried [shape=plain, fixedsize=false, width=0, height=0, pos="110,-110!", label=<<FONT POINT-SIZE="18" COLOR="#747B82"><B>Tried and<BR/>left out</B></FONT>>];
km [pos="308,-110!", width=2.45, height=2.0, style="rounded,dashed,filled", color="#9AA0A6", fillcolor="white", label=<<FONT POINT-SIZE="15" COLOR="#747B82">k-means affect<BR ALIGN="LEFT"/>grouping: told<BR ALIGN="LEFT"/>+1.10, reader<BR ALIGN="LEFT"/>+0.16<BR ALIGN="LEFT"/></FONT>>];
groupings -> km [style=dotted, color="#9AA0A6", arrowhead=none, pos="280,314.6 280,235 280,235 280,235 280,235 308,235 308,235 308,235 308,-20 308,-38"];
csd [pos="506,-110!", width=2.45, height=2.0, style="rounded,dashed,filled", color="#9AA0A6", fillcolor="white", label=<<FONT POINT-SIZE="15" COLOR="#747B82">CSD style grouping:<BR ALIGN="LEFT"/>told ceiling +2.23,<BR ALIGN="LEFT"/>but reader +0.06<BR ALIGN="LEFT"/></FONT>>];
groupings -> csd [style=dotted, color="#9AA0A6", arrowhead=none, pos="308,314.6 308,260 308,260 308,260 308,260 506,260 506,260 506,260 506,-20 506,-38"];
leiden [pos="704,-110!", width=2.45, height=2.0, style="rounded,dashed,filled", color="#9AA0A6", fillcolor="white", label=<<FONT POINT-SIZE="15" COLOR="#747B82">Leiden for image<BR ALIGN="LEFT"/>and caption: reader<BR ALIGN="LEFT"/>−0.32<BR ALIGN="LEFT"/></FONT>>];
groupings -> leiden [style=dotted, color="#9AA0A6", arrowhead=none, pos="336,314.6 336,285 336,285 336,285 336,285 704,285 704,285 704,285 704,-20 704,-38"];
other_readers [pos="902,-110!", width=2.45, height=2.0, style="rounded,dashed,filled", color="#9AA0A6", fillcolor="white", label=<<FONT POINT-SIZE="15" COLOR="#747B82">noise-scaled rule:<BR ALIGN="LEFT"/>+0.230; adapted<BR ALIGN="LEFT"/>reader: +0.116;<BR ALIGN="LEFT"/>retrained reader:<BR ALIGN="LEFT"/>+0.077<BR ALIGN="LEFT"/></FONT>>];
reader -> other_readers [style=dotted, color="#9AA0A6", arrowhead=none, pos="902,314.6 902,290 902,290 902,290 902,290 902,290 902,290 902,290 902,-20 902,-38"];
veto [pos="1298,-110!", width=2.45, height=2.0, style="rounded,dashed,filled", color="#9AA0A6", fillcolor="white", label=<<FONT POINT-SIZE="15" COLOR="#747B82">vetoes on AFF<BR ALIGN="LEFT"/>(round 4): none<BR ALIGN="LEFT"/>beat AFF (net −18,<BR ALIGN="LEFT"/>−18, −34 rankings)<BR ALIGN="LEFT"/></FONT>>];
rule -> veto [style=dotted, color="#9AA0A6", arrowhead=none, pos="1298,314.6 1298,290 1298,290 1298,290 1298,290 1298,290 1298,290 1298,290 1298,-20 1298,-38"];
legend [shape=plain, fixedsize=false, width=0, height=0, pos="800,-245!", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="15"><TR><TD><FONT COLOR="#1B8A7A" POINT-SIZE="16">teal border = component of AFF</FONT></TD><TD><FONT COLOR="#747B82" POINT-SIZE="16">grey = shared condition-free base</FONT></TD><TD><FONT COLOR="#747B82" POINT-SIZE="16">dashed grey = tried and left out</FONT></TD></TR></TABLE>>];
}